# Secrets - never commit
.env
*.pem
*.key

# Data - regenerated by the pipeline, never in Git
data/
*.parquet
*.duckdb
*.duckdb.wal
*.zip
*.csv
*.xlsx

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# dbt
target/
dbt_packages/
logs/

# Editors / OS
.vscode/
.idea/
.DS_Store
!dbt/seeds/*.csv
